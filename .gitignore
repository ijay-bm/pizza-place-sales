# Environment files hold secrets and per-machine values; each has a committed .example beside it.
.env
.env.backup
.env.production

# Dependencies and build output
node_modules/
/apps/*/dist
/apps/api/vendor
/apps/api/public/storage
/apps/api/storage/*.key
/apps/api/storage/pail
/apps/api/.phpunit.cache
.phpunit.result.cache

