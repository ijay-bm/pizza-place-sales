# Read by docker compose only. Laravel's own settings are apps/api/.env; the
# DB_* values here must equal its DB_* lines, since compose creates the
# database and the account Laravel connects with.

# Owner of the files the containers write into the working tree.
UID=1000
GID=1000

# Host ports. Everything is served through nginx on HTTP_PORT; the database
# ports are bound to 127.0.0.1 for a database client on the host.
HTTP_PORT=8080
DB_FORWARD_PORT=3306
DB_TEST_FORWARD_PORT=3307

DB_DATABASE=pizza_place_sales
DB_USERNAME=pizza_place_sales
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
